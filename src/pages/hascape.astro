---
import Main from "../layouts/main.astro";
import HaScape from "../components/HaScape";
import { isAuthorized, getTokenFromCookie } from "../lib/auth-ssr";

const authorized = await isAuthorized(Astro.request);

if (!authorized) {
    return Astro.redirect('/login?redirect_to=mapEditor');
}

const token = await getTokenFromCookie(Astro.request.headers.get('cookie'));
const playerId = Astro.url.searchParams.get('id');

--- 

<Main>
    <HaScape token={token as string} apiUrl={import.meta.env.PUBLIC_API_URL as string} playerId={playerId} client:only />
</Main>

