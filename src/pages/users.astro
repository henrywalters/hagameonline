---
import Main from "../layouts/main.astro";
import { getUser } from "../lib/api";
import { getTokenFromCookie } from "../lib/auth-ssr";
import { isAuthorized } from "../lib/auth-ssr";

const authorized = await isAuthorized(Astro.request);

let token;
let user = {};

if (!authorized) {
    return Astro.redirect('/login');
}
 
token = getTokenFromCookie(Astro.request.headers.get('cookie'));

user = await getUser(token as string);

---

<Main>
    <div id="token" data-token={token} />
    <div id="user" data-user={JSON.stringify(user)} />
    <table class="border border-white text-white">
        <thead class="text-left">
            <th class="border">Email</th>
            <th class="border">Auth Level</th>
            <th class="border">Created On</th>
        </thead>
        <tbody id="users">

        </tbody>
    </table>
</Main>

<script>

    const userEl = document.getElementById('user');
    const currentUser = JSON.parse(userEl!.dataset.user as string);
    
    const tokenEl = document.getElementById('token');

    const token = tokenEl!.dataset.token;

    const getUsers = async () => {
        const response = await fetch(`${import.meta.env.PUBLIC_API_URL}/user`, {
            method: 'GET',
            headers: {
                'Content-Type': 'application/json',
                authorization: token,
            }
        });
        const users = await response.json();

        const userEl = document.getElementById('users')!;

        userEl.innerHTML = '';

        for (const user of users) {
            const row = document.createElement('tr');
            const email = document.createElement('td');
            email.innerHTML = user.email;

            const authLevel = document.createElement('td');

            if (currentUser.authLevel === 'super_admin') {
                const selector = document.createElement('select');

                for (const level of ['default', 'admin', 'super_admin']) {
                    const option = document.createElement('option');
                    option.value = level;
                    option.label = level;
                    option.style.color = 'black';
                    selector.appendChild(option);
                }

                const saveBtn = document.createElement('button');
                saveBtn.innerHTML = 'Save';
                saveBtn.style.display = 'none';
                saveBtn.className = 'ml-3 border pl-3 pr-3 hover:border-blue-600 hover:text-blue-600 hover:cursor-pointer'

                saveBtn.addEventListener('click', async (e) => {
                    const response = await fetch(`${import.meta.env.PUBLIC_API_URL}/user/auth-level`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            authorization: token,
                        },
                        body: JSON.stringify({
                            user_id: user.userId,
                            auth_level: selector.value, 
                        })
                    });

                    if (response.status === 200) {
                        getUsers();
                    }
                })

                selector.className = ' text-white text-sm px-2 py-1 rounded border border-white/20 focus:outline-none focus:border-white/50 cursor-pointer';

                selector.addEventListener('change', (e) => {
                    console.log(selector.value, user.authLevel);
                    if (selector.value !== user.authLevel) {
                        saveBtn.style.display = 'block';
                    } else {
                        saveBtn.style.display = 'none';
                    }
                })

                selector.value = user.authLevel;
                authLevel.className = 'flex'
                authLevel.appendChild(selector);
                authLevel.appendChild(saveBtn);
            } else {
                authLevel.innerHTML = user.authLevel;
            }



            const created = document.createElement('td');
            created.innerHTML = user.createdOn;

            email.classList.add('p-3');
            authLevel.classList.add('p-3');
            created.classList.add('p-3');

            row.appendChild(email);
            row.appendChild(authLevel);
            row.appendChild(created);

            userEl.appendChild(row);
        }
    }

    getUsers();

</script>