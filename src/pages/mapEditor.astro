---
import Main from "../layouts/main.astro";
import { getTokenFromCookie } from "../lib/auth-ssr";
import { isAuthorized } from "../lib/auth-ssr";
import { MapEditorPage } from "../components/MapEditor";

const authorized = await isAuthorized(Astro.request);

let token = null;

if (!authorized) {
    return Astro.redirect('/login?redirect_to=mapEditor');
}

token = await getTokenFromCookie(Astro.request.headers.get('cookie'));

---

<Main>
    <MapEditorPage token={token as string} apiUrl={import.meta.env.PUBLIC_API_URL as string} client:only />
</Main>

