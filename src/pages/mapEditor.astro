---
import Main from "../layouts/main.astro";
import { getTokenFromCookie } from "../lib/auth-ssr";
import { isAuthorized } from "../lib/auth-ssr";

const authorized = await isAuthorized(Astro.request);

let canPlay = false;
let user = {};
let token = null;

if (authorized) {
    token = await getTokenFromCookie(Astro.request.headers.get('cookie'));
    console.log(token);
}
---

<Main>
    <div class="flex">
        <div class="border p-3 bg-white mr-3" id="ui">
            
        </div>
        <div id="game"></div>
        <div class="border p-3 bg-white ml-3" id="sidebar">
            
        </div>
    </div>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@shoelace-style/shoelace@2.20.1/cdn/themes/light.css" />
<script type="module" src="https://cdn.jsdelivr.net/npm/@shoelace-style/shoelace@2.20.1/cdn/shoelace-autoloader.js"></script>

</Main>

<script>
    
    import { makeMapEditor } from "@hascape/client/editor";
    import { Game } from "hagamets/dist/core/game";


    makeMapEditor(
        document.getElementById('game')! as HTMLDivElement, 
        document.getElementById('ui')! as HTMLDivElement, 
        document.getElementById('sidebar')! as HTMLDivElement
    );

</script>